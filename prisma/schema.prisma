generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Client {
  id                 String              @id @default(cuid())
  workspaceId        String
  name               String
  phone              String
  phoneNormalized    String
  email              String?
  company            String?
  notes              String?
  optIn              Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  clientGroups       ClientGroup[]
  campaignRecipients CampaignRecipient[]
  cases              Case[]
  whatsappMessages   WhatsAppMessage[]
  conversations      Conversation[]
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phoneNormalized])
  @@index([workspaceId])
}

model Workspace {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               WorkspaceMember[]
  clients               Client[]
  groups                Group[]
  campaigns             Campaign[]
  invitations           WorkspaceInvitation[]
  activities            Activity[]
  cases                 Case[]
  sequence              WorkspaceSequence?
  modules               WorkspaceModule[]
  whatsappConnections   WhatsAppConnection[]
  whatsappMessages      WhatsAppMessage[]
  whatsappWebhookEvents WhatsAppWebhookEvent[]
  conversations         Conversation[]
  caseConversations     CaseConversation[]
}

model WorkspaceModule {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  enabled     Boolean
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, enabled])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum WorkspacePermission {
  CONTACT_VIEW
  CONTACT_CREATE
  CONTACT_EDIT
  CONTACT_DELETE
  GROUP_VIEW
  GROUP_CREATE
  GROUP_EDIT
  GROUP_DELETE
  GROUP_MANAGE_MEMBERS
  CAMPAIGN_VIEW
  CAMPAIGN_CREATE
  CAMPAIGN_EDIT
  CAMPAIGN_SEND
  CAMPAIGN_DELETE
  TICKET_VIEW
  TICKET_CREATE
  TICKET_EDIT
  TICKET_ASSIGN
  TICKET_RESOLVE
  INCIDENT_VIEW
  INCIDENT_CREATE
  INCIDENT_EDIT
  INCIDENT_ASSIGN
  INCIDENT_RESOLVE
  ORDER_VIEW
  ORDER_CREATE
  ORDER_EDIT
  ORDER_MANAGE_STATUS
  ORDER_MANAGE_PAYMENT
  INBOX_VIEW
  INBOX_REPLY
  INBOX_MANAGE
  WORKSPACE_SETTINGS_VIEW
  WORKSPACE_SETTINGS_EDIT
  TEAM_VIEW
  TEAM_METRICS_VIEW
  TEAM_MANAGE
  PERMISSIONS_MANAGE
}

enum GroupScopeMode {
  ALL
  SELECTED
}

model WorkspaceMember {
  id                        String                @id @default(cuid())
  workspaceId               String
  userId                    String
  role                      WorkspaceRole         @default(VIEWER)
  groupScopeMode            GroupScopeMode        @default(ALL)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissionOverrides       MemberPermission[]
  groupAccess               MemberGroupAccess[]
  sentInvitations           WorkspaceInvitation[] @relation("InvitedByMember")
  acceptedInvitations       WorkspaceInvitation[] @relation("AcceptedMember")
  activities                Activity[]            @relation("ActivityActor")
  createdCases              Case[]                @relation("CaseCreator")
  assignedTickets           TicketDetails[]       @relation("TicketAssignee")
  ticketParticipations      TicketParticipant[]   @relation("TicketParticipantMember")
  addedTicketParticipants   TicketParticipant[]   @relation("TicketParticipantAdder")
  ticketNotes               TicketNote[]          @relation("TicketNoteAuthor")
  assignedIncidents         IncidentDetails[]     @relation("IncidentAssignee")
  incidentParticipations    IncidentParticipant[] @relation("IncidentParticipantMember")
  addedIncidentParticipants IncidentParticipant[] @relation("IncidentParticipantAdder")
  incidentNotes             IncidentNote[]        @relation("IncidentNoteAuthor")
  linkedIncidentTickets     IncidentTicket[]      @relation("IncidentTicketLinker")
  scheduledCampaigns        Campaign[]            @relation("CampaignScheduler")
  conversationReadStates    ConversationReadState[]
  sentWhatsAppMessages      WhatsAppMessage[]     @relation("InboxMessageSender")
  createdCaseConversations  CaseConversation[]    @relation("CaseConversationCreator")

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceSequence {
  workspaceId    String    @id
  caseNextNumber Int       @default(1)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Case {
  id                   String                @id @default(cuid())
  workspaceId          String
  number               Int
  contactId            String?
  type                 String
  title                String
  description          String?
  status               String
  priority             String?
  createdByMemberId    String?
  createdByUserId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  closedAt             DateTime?
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact              Client?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdByMember      WorkspaceMember?      @relation("CaseCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  ticketDetails        TicketDetails?
  ticketParticipants   TicketParticipant[]
  ticketNotes          TicketNote[]
  incidentDetails      IncidentDetails?
  incidentParticipants IncidentParticipant[]
  incidentNotes        IncidentNote[]
  incidentTicketLinks  IncidentTicket[]      @relation("IncidentCaseLinks")
  ticketIncidentLinks  IncidentTicket[]      @relation("TicketCaseLinks")
  orderDetails         OrderDetails?
  orderItems           OrderItem[]
  conversations        CaseConversation[]

  @@unique([workspaceId, number])
  @@unique([id, workspaceId])
  @@index([workspaceId, type, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, contactId, createdAt])
  @@index([createdByMemberId])
}

model OrderDetails {
  id               String   @id @default(cuid())
  caseId           String   @unique
  paymentStatus    String   @default("PENDING")
  fulfillmentType  String   @default("PICKUP")
  fulfillmentNotes String?
  subtotal         Decimal  @default(0) @db.Decimal(18, 2)
  discount         Decimal  @default(0) @db.Decimal(18, 2)
  total            Decimal  @default(0) @db.Decimal(18, 2)
  currency         String   @default("ARS")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id          String   @id @default(cuid())
  orderCaseId String
  description String
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderCase   Case     @relation(fields: [orderCaseId], references: [id], onDelete: Cascade)

  @@index([orderCaseId, position])
}

model TicketDetails {
  id               String           @id @default(cuid())
  caseId           String           @unique
  assignedMemberId String?
  resolution       String?
  source           String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedMember   WorkspaceMember? @relation("TicketAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([assignedMemberId])
}

model TicketParticipant {
  id              String           @id @default(cuid())
  caseId          String
  memberId        String?
  memberUserId    String
  addedByMemberId String?
  addedByUserId   String?
  createdAt       DateTime         @default(now())
  case            Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member          WorkspaceMember? @relation("TicketParticipantMember", fields: [memberId], references: [id], onDelete: SetNull)
  addedByMember   WorkspaceMember? @relation("TicketParticipantAdder", fields: [addedByMemberId], references: [id], onDelete: SetNull)

  @@unique([caseId, memberId])
  @@index([memberId])
  @@index([addedByMemberId])
}

model TicketNote {
  id             String           @id @default(cuid())
  caseId         String
  authorMemberId String?
  authorUserId   String?
  body           String
  createdAt      DateTime         @default(now())
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorMember   WorkspaceMember? @relation("TicketNoteAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([authorMemberId])
}

model IncidentDetails {
  id               String           @id @default(cuid())
  caseId           String           @unique
  assignedMemberId String?
  resolution       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignedMember   WorkspaceMember? @relation("IncidentAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)

  @@index([assignedMemberId])
}

model IncidentParticipant {
  id              String           @id @default(cuid())
  caseId          String
  memberId        String?
  memberUserId    String
  addedByMemberId String?
  addedByUserId   String?
  createdAt       DateTime         @default(now())
  case            Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  member          WorkspaceMember? @relation("IncidentParticipantMember", fields: [memberId], references: [id], onDelete: SetNull)
  addedByMember   WorkspaceMember? @relation("IncidentParticipantAdder", fields: [addedByMemberId], references: [id], onDelete: SetNull)

  @@unique([caseId, memberId])
  @@index([memberId])
  @@index([addedByMemberId])
}

model IncidentNote {
  id             String           @id @default(cuid())
  caseId         String
  authorMemberId String?
  authorUserId   String?
  body           String
  createdAt      DateTime         @default(now())
  case           Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorMember   WorkspaceMember? @relation("IncidentNoteAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@index([authorMemberId])
}

model IncidentTicket {
  incidentCaseId   String
  ticketCaseId     String
  linkedByMemberId String?
  linkedByUserId   String?
  createdAt        DateTime         @default(now())
  incidentCase     Case             @relation("IncidentCaseLinks", fields: [incidentCaseId], references: [id], onDelete: Cascade)
  ticketCase       Case             @relation("TicketCaseLinks", fields: [ticketCaseId], references: [id], onDelete: Cascade)
  linkedByMember   WorkspaceMember? @relation("IncidentTicketLinker", fields: [linkedByMemberId], references: [id], onDelete: SetNull)

  @@id([incidentCaseId, ticketCaseId])
  @@index([ticketCaseId])
  @@index([linkedByMemberId])
}

model Activity {
  id            String           @id @default(cuid())
  workspaceId   String
  actorUserId   String?
  actorMemberId String?
  entityType    String
  entityId      String?
  action        String
  metadata      Json?
  createdAt     DateTime         @default(now())
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorMember   WorkspaceMember? @relation("ActivityActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, createdAt])
  @@index([actorMemberId])
}

model MemberPermission {
  id         String              @id @default(cuid())
  memberId   String
  permission WorkspacePermission
  allowed    Boolean
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  member     WorkspaceMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, permission])
}

model MemberGroupAccess {
  id        String          @id @default(cuid())
  memberId  String
  groupId   String
  createdAt DateTime        @default(now())
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([memberId, groupId])
  @@index([groupId])
}

model Group {
  id               String                           @id @default(cuid())
  workspaceId      String
  name             String
  description      String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  clientGroups     ClientGroup[]
  sourceCampaigns  Campaign[]                       @relation("SourceGroupCampaigns")
  memberAccess     MemberGroupAccess[]
  invitationAccess WorkspaceInvitationGroupAccess[]
  workspace        Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceInvitation {
  id                String                           @id @default(cuid())
  workspaceId       String
  email             String
  role              WorkspaceRole
  groupScopeMode    GroupScopeMode                   @default(SELECTED)
  tokenHash         String                           @unique
  invitedByMemberId String?
  acceptedMemberId  String?
  expiresAt         DateTime
  acceptedAt        DateTime?
  acceptedByUserId  String?
  revokedAt         DateTime?
  emailAttemptedAt  DateTime?
  emailSentAt       DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  workspace         Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByMember   WorkspaceMember?                 @relation("InvitedByMember", fields: [invitedByMemberId], references: [id], onDelete: SetNull)
  acceptedMember    WorkspaceMember?                 @relation("AcceptedMember", fields: [acceptedMemberId], references: [id], onDelete: SetNull)
  groupAccess       WorkspaceInvitationGroupAccess[]

  @@index([workspaceId, email])
  @@index([acceptedMemberId])
}

model WorkspaceInvitationGroupAccess {
  id           String              @id @default(cuid())
  invitationId String
  groupId      String
  invitation   WorkspaceInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([invitationId, groupId])
  @@index([groupId])
}

model ClientGroup {
  clientId  String
  groupId   String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([clientId, groupId])
  @@index([groupId])
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  COMPLETED
  PARTIAL
  FAILED
}

enum RecipientStatus {
  PENDING
  PROCESSING
  ACCEPTED
  DELIVERED
  READ
  FAILED
}

model Campaign {
  id                  String              @id @default(cuid())
  workspaceId         String
  name                String
  message             String
  status              CampaignStatus      @default(DRAFT)
  sourceGroupId       String?
  scheduledAt         DateTime?
  scheduledTimezone   String?
  scheduleGeneration  String?
  scheduledByMemberId String?
  scheduledByUserId   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sourceGroup         Group?              @relation("SourceGroupCampaigns", fields: [sourceGroupId], references: [id], onDelete: SetNull)
  scheduledByMember   WorkspaceMember?    @relation("CampaignScheduler", fields: [scheduledByMemberId], references: [id], onDelete: SetNull)
  recipients          CampaignRecipient[]
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sourceGroupId])
  @@index([scheduledByMemberId])
  @@index([workspaceId])
  @@index([workspaceId, status, scheduledAt])
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  clientId          String?
  nameSnapshot      String
  phoneSnapshot     String
  status            RecipientStatus @default(PENDING)
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client            Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phoneSnapshot])
  @@index([campaignId, status])
  @@index([clientId])
}

model WhatsAppConnection {
  id                 String            @id @default(cuid())
  workspaceId        String
  wabaId             String
  phoneNumberId      String            @unique
  displayPhoneNumber String?
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages           WhatsAppMessage[]
  conversations      Conversation[]

  @@index([workspaceId])
  @@index([wabaId])
}

model WhatsAppMessage {
  id                String              @id @default(cuid())
  workspaceId       String
  connectionId      String?
  clientId          String?
  conversationId    String?
  providerMessageId String?             @unique
  clientRequestId   String?
  sentByMemberId    String?
  sentByUserId      String?
  phoneNumberId     String
  waId              String?
  direction         String
  type              String
  status            String
  textBody          String?
  profileName       String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection        WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  client            Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  conversation      Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sentByMember      WorkspaceMember?    @relation("InboxMessageSender", fields: [sentByMemberId], references: [id], onDelete: SetNull)
  sourceCaseConversations CaseConversation[]

  @@unique([workspaceId, clientRequestId])
  @@index([workspaceId, createdAt])
  @@index([sentByMemberId])
  @@index([connectionId, createdAt])
  @@index([clientId, createdAt])
  @@index([phoneNumberId, createdAt])
  @@index([conversationId, createdAt, id])
}

model Conversation {
  id                    String                  @id @default(cuid())
  workspaceId           String
  channel               String                  @default("WHATSAPP")
  clientId              String?
  whatsappConnectionId  String?
  externalParticipantId String
  externalDisplayName   String?
  status                String                  @default("OPEN")
  lastMessageAt         DateTime
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  workspace             Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  whatsappConnection    WhatsAppConnection?     @relation(fields: [whatsappConnectionId], references: [id], onDelete: SetNull)
  messages              WhatsAppMessage[]
  readStates            ConversationReadState[]
  cases                 CaseConversation[]

  @@unique([workspaceId, whatsappConnectionId, externalParticipantId])
  @@unique([id, workspaceId])
  @@index([workspaceId, lastMessageAt, id])
  @@index([workspaceId, clientId])
}

model CaseConversation {
  id                String           @id @default(cuid())
  workspaceId       String
  caseId            String
  conversationId    String
  sourceMessageId   String?
  createdByMemberId String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case              Case             @relation(fields: [caseId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversation      Conversation     @relation(fields: [conversationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sourceMessage     WhatsAppMessage? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  createdByMember   WorkspaceMember? @relation("CaseConversationCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@unique([caseId, conversationId])
  @@index([workspaceId, conversationId, createdAt])
  @@index([workspaceId, caseId])
  @@index([sourceMessageId])
}

model ConversationReadState {
  id             String          @id @default(cuid())
  conversationId String
  memberId       String
  lastReadAt     DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member         WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@index([memberId, lastReadAt])
}

model WhatsAppWebhookEvent {
  id              String     @id @default(cuid())
  eventKey        String     @unique
  workspaceId     String?
  wabaId          String?
  phoneNumberId   String?
  eventType       String
  payload         Json
  receivedAt      DateTime   @default(now())
  processedAt     DateTime?
  processingError String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([phoneNumberId, receivedAt])
  @@index([eventType, receivedAt])
}
