DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/billetera_clientes?schema=public"
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# WhatsApp Cloud API (completar solamente en .env local)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Motor de envío. Por ahora el único valor soportado es "mock".
MESSAGE_PROVIDER="mock"

# Invitaciones a Workspaces (solo servidor). From debe usar un dominio verificado en Resend.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
INVITATION_FROM_NAME=
# URL pública opcional; en Vercel se usa la URL del deployment automáticamente.
APP_URL=
